# Binance API Credentials
# IMPORTANT: Rename this file to .env and add your real API keys
# NEVER commit the .env file to git!

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ============================================================================
# TRADING MODE - START HERE!
# ============================================================================
# PAPER_TRADING=True  -> Simulates trades without real money (RECOMMENDED!)
# PAPER_TRADING=False -> Places REAL orders on Binance (only after 3 months of paper trading)
PAPER_TRADING=True

# Trading Parameters
LEVERAGE=3
MAX_POSITION_SIZE_USD=100
MAX_DAILY_LOSS_USD=500
MAX_OPEN_POSITIONS=2
